# Copy to .env for local development. .env is git-ignored - never commit real keys.

# --- Access -----------------------------------------------------------------
# Comma-separated API keys. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Set to true only on your own machine. The service refuses to start with no keys otherwise.
AUTH_DISABLED=false
RATE_LIMIT_PER_MINUTE=120
# Comma-separated browser origins allowed to call the API. Empty disables CORS.
CORS_ORIGINS=

# --- Warehouse --------------------------------------------------------------
WAREHOUSE=duckdb                 # duckdb (local, seeded from data/seed) | bigquery
DUCKDB_PATH=data/warehouse.duckdb
SEED_DIR=data/seed

# BigQuery (WAREHOUSE=bigquery). Auth is Application Default Credentials.
GCP_PROJECT_ID=
BQ_DATASET=marketing_reporting
BQ_LOCATION=US
BQ_MAX_BYTES_BILLED=1000000000   # a query that would scan more is refused before it runs
BQ_QUERY_TIMEOUT_SECONDS=30

# --- Behaviour --------------------------------------------------------------
CACHE_TTL_SECONDS=300            # 0 disables caching
DEFAULT_RANGE_DAYS=30
MAX_RANGE_DAYS=366
PACING_OVER_THRESHOLD=1.10
PACING_UNDER_THRESHOLD=0.85
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | text
